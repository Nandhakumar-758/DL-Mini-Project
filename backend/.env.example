# Copy to backend/.env and edit. All variables are optional.

# Directory holding next_word_lstm_model.keras + tokenizer.json (+ metadata/history/evaluation json).
# Paths are resolved relative to the directory you start uvicorn from (backend/).
MOZHI_ARTIFACT_DIR=../artifacts

# To try the tiny development model trained on the illustrative sample corpus:
# MOZHI_ARTIFACT_DIR=../artifacts/dev_sample

# MOZHI_MODEL_FILENAME=next_word_lstm_model.keras
# MOZHI_TOKENIZER_FILENAME=tokenizer.json

# SQLite file for opt-in history + settings (kept separate from model artifacts).
# MOZHI_DB_PATH=./var/mozhipredict.db

# JSON list of allowed browser origins (Vite dev server by default).
# MOZHI_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Allow the labelled vocabulary-frequency auto-complete fallback when the LSTM is missing.
# MOZHI_ALLOW_VOCABULARY_FALLBACK=true
